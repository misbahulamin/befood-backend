# Copy to `.env` for local use. Never commit `.env` (secrets stay on the machine / host).
DJANGO_ENV=local
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local Postgres (defaults match core/settings/local.py). Production sets these on the host.
DB_NAME=befood
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

EMAIL_HOST_USER=misbahul@mypanaceatech.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Befood <misbahul@mypanaceatech.com>
FRONTEND_URL=http://localhost:5173
BKASH_APP_KEY=
BKASH_APP_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=

# AWS S3 media — leave empty / false for now; uncomment & fill when verifying S3 later.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=befood-production-media
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=
USE_S3_MEDIA=false
