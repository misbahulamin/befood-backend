# Copy to `.env` next to manage.py (project root). Never commit `.env`.
# Boot: python-dotenv loads this file into the process env (OS/systemd values win).
# Typed settings (AWS_*, USE_S3_MEDIA, etc.) still use python-decouple config().
DJANGO_ENV=local
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local Postgres (defaults match core/settings/local.py). Production sets these on the host.
DB_NAME=befood
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

EMAIL_HOST_USER=misbahul@mypanaceatech.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Befood <misbahul@mypanaceatech.com>
FRONTEND_URL=http://localhost:5173
BKASH_APP_KEY=
BKASH_APP_SECRET=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASS=

# AWS S3 media (optional). Leave USE_S3_MEDIA=false for local disk MEDIA_ROOT.
# Prefer IAM role on EC2; access keys are optional when the instance role can reach the bucket.
# Never commit real secrets — fill these only in host `.env` / systemd Environment=.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
USE_S3_MEDIA=false
